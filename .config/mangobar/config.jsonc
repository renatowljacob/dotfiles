{
    "height": 20,
    "modules-left": [
        "workspaces",
        "layout",
        "window"
    ],
    "modules-center": [],
    "modules-right": [
        "hideclients",
        "custom/volume",
        "cpu",
        "memory",
        "network",
        "clock#time",
        "clock#date",
        "tray"
    ],
    "workspaces": {
        "hide-empty": false,
        "tag-names": ["", "", "", "", "", ""],
        "on-click": "activate",
        "on-click-right": "toggle",
        "scroll-interval": 100,
        "on-scroll-up": "mmsg dispatch viewtoleft_have_client",
        "on-scroll-down": "mmsg dispatch viewtoright_have_client"
    },
    "window": {
        "max-length": 0
    },
    "hideclients": {
        "format": " {}"
    },
    "custom/volume": {
        "exec": "mangobar-volume",
        "signal": 8,
        "on-click": "volume mute",
        "on-scroll-up": "volume up",
        "on-scroll-down": "volume down"
    },
    "custom/updates": {
        "exec": "mangobar-updates",
        "signal": 9,
        "interval": 3600, // an hour
        "on-click": "mangobar-updatesclick"
    },
    "cpu": {
        "format": " {load}%"
    },
    "memory": {
        "format": " {}%"
    },
    "network": {
        "format": "{icon} {ifname}",
        "format-wifi": "{signal} {ssid}",
        "icon-wifi": "󰖩",
        "icon-ethernet": "󰈀",
        "icon-disconnected": "󰖪",
        "signal-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "format-alt": "↓{down} ↑{up}"
    },
    "clock#time": {
        "format": " %R"
    },
    "clock#date": {
        "format": " %a %d %B %Y"
    }
}
